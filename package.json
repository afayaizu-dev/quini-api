{
  "name": "quini-api",
  "version": "1.0.0",
  "description": "API REST autenticada para la gestión de una peña de quiniela",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --env-file=.env.test node_modules/vitest/vitest.mjs run",
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:reset": "docker compose -f docker/docker-compose.yml down -v && npm run db:up",
    "db:psql": "docker compose -f docker/docker-compose.yml exec postgres psql -U quini -d quini",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env node_modules/drizzle-kit/bin.cjs studio",
    "db:embedded": "node --env-file=.env --import tsx scripts/db-embedded.ts",
    "admin:create": "node --env-file=.env --import tsx scripts/create-admin.ts",
    "token": "node --env-file=.env --import tsx scripts/mint-token.ts",
    "openapi:generate": "node --env-file=.env --import tsx src/openapi/generate.ts",
    "openapi:lint": "node node_modules/@stoplight/spectral-cli/dist/index.js lint openapi/openapi.json",
    "test:watch": "node --env-file=.env.test node_modules/vitest/vitest.mjs",
    "test:cov": "node --env-file=.env.test node_modules/vitest/vitest.mjs run --coverage",
    "insomnia:test": "inso run test --src insomnia/quini-api.insomnia.yaml --env Local"
  },
  "keywords": [],
  "type": "module",
  "private": "true",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.16.3",
    "@types/cors": "^2.8.19",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "9.1.7",
    "insomnia-inso": "^2.4.1",
    "lint-staged": "17.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --fix",
    "*.{json,md,yml}": "prettier --write"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.0"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "node-libcurl@2.3.3": false,
    "@scarf/scarf": false,
    "esbuild@0.28.2": true,
    "@getinsomnia/node-libcurl@2.3.4-3": false
  }
}
