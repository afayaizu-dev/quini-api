# --- Servidor ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
API_BASE_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Base de datos ---
DB_MODE=docker
DATABASE_URL=postgresql://quiniela:quiniela@localhost:5432/quiniela
EMBEDDED_PG_PORT=54329
EMBEDDED_PG_DIR=./.pgdata

# --- JWT ---
JWT_ISSUER=api-quiniela
JWT_AUDIENCE=api-quiniela-clients
JWT_ALG=HS256
JWT_SECRET=cambia-esto-por-32-bytes-aleatorios
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Cookies ---
COOKIE_SECRET=cambia-esto-tambien

# --- Invitaciones ---
INVITATION_TTL=7d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# --- Observabilidad ---
METRICS_ENABLED=true
METRICS_PATH=/metrics
OTEL_ENABLED=false
OTEL_SERVICE_NAME=api-quiniela
OTEL_EXPORTER_OTLP_ENDPOINT=http://

# --- Solo desarrollo ---
ENABLE_DEV_TOKENS=true
