# --- Servidor ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
API_BASE_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Base de datos ---
DB_MODE=docker
DATABASE_URL=postgresql://quini:quini@localhost:5432/quini
EMBEDDED_PG_PORT=54329
EMBEDDED_PG_DIR=./.pgdata

# --- JWT ---
JWT_ISSUER=api-quini
JWT_AUDIENCE=api-quini-clients
JWT_ALG=HS256
JWT_SECRET=cambia-esto-por-32-bytes-aleatorios
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Cookies ---
COOKIE_SECRET=cambia-esto-tambien-por-32-bytes-aleatorios

# --- Invitaciones ---
INVITATION_TTL=7d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# --- Envío de correo (Gmail API) ---
# Se obtienen con "npm run mail:authorize" (reutiliza GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET de arriba)
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# --- Transporte de correo: gmail (por defecto) o smtp ---
MAIL_TRANSPORT=gmail
# Solo con MAIL_TRANSPORT=smtp. Ejemplo iCloud: smtp.mail.me.com:587, usuario = cuenta iCloud,
# contraseña = contraseña específica de app, remitente = dirección del dominio propio.
MAIL_FROM="Quiniweb <admin@quiniweb.com>"
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Observabilidad ---
# Lo inyecta el build de Docker (GIT_SHA); sin valor, /health devuelve commit: null
APP_COMMIT=
METRICS_ENABLED=true
METRICS_PATH=/metrics
OTEL_SERVICE_NAME=api-quini
OTEL_EXPORTER_OTLP_ENDPOINT=http://


